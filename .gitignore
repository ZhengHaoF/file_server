# ==============================
# 通用忽略规则
# ==============================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build outputs
dist
dist-ssr
coverage
*.local

# 打包产物（npm run pack 生成，用于上传 Releases）
file-serve-v*.zip

# OS
.DS_Store
Thumbs.db

# ==============================
# 后端 (server/) 特有
# ==============================

# 运行时生成的缓存和数据库
server/imgCache/
server/imgCache.db
server/logs/

# node 可执行文件（历史打包/捆绑方案遗留，保持忽略）
server/node.exe
server/node.zip

# ==============================
# Flutter (flutter-app/) 特有
# ==============================

# flutter-app/ 下有独立的 .gitignore，这里补充根级忽略
flutter-app/.dart_tool/
flutter-app/.flutter-plugins-dependencies
flutter-app/build/
flutter-app/.metadata

# ==============================
# 编辑器 / IDE
# ==============================

.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================
# 项目文档（可选忽略）
# ==============================

后端接口修改方案.md
前端实施文档.md

# ==============================
# AI 助手本地工作区（记忆 / 技能，不入库）
# ==============================

.workbuddy/
