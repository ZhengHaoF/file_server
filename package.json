{
  "name": "file-serve",
  "private": true,
  "description": "简易文件服务器 monorepo - 针对大量查看NAS图片的需求开发",
  "scripts": {
    "dev:server": "cd server && npm start",
    "dev:web": "cd web && npm run dev",
    "dev:admin": "cd admin && npm run dev",
    "build:server": "cd server && npm run build",
    "build:web": "cd web && npm run build",
    "build:admin": "cd admin && npm run build",
    "dev:android": "cd android-app && ./gradlew assembleDebug",
    "build:android": "cd android-app && ./gradlew assembleRelease",
    "build:all": "npm run build:server && npm run build:web && npm run build:admin && npm run build:android"
  }
}
