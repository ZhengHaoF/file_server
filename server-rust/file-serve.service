# Install service account + directories before enabling this unit; see README.
[Unit]
Description=File Serve Rust NAS service
After=network.target

[Service]
Type=simple
User=fileserve
Group=fileserve
WorkingDirectory=/opt/file-serve
Environment=FILE_SERVER_ROOT=/srv/file-serve/files
Environment=FILE_SERVER_DATA_DIR=/var/lib/file-serve/data
Environment=FILE_SERVER_CACHE_DIR=/var/cache/file-serve
Environment=FILE_SERVER_STATIC_DIR=/opt/file-serve/static
Environment=FILE_SERVER_HOST=127.0.0.1
Environment=FILE_SERVER_PORT=3000
Environment=FILE_SERVER_MANAGED=1
Environment=FILE_SERVER_DEPLOYMENT=systemd
ExecStart=/opt/file-serve/file-server
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/file-serve /var/cache/file-serve
# Shared files remain read-only unless explicitly opted into writes.
ReadOnlyPaths=/srv/file-serve/files
UMask=0077
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
