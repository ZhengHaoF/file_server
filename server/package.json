{
    "name": "file-serve",
    "version": "1.0.0",
    "description": "针对大量查看NAS图片的需求开发，不改变文件结构，支持实时压缩图片。体验超丝滑\r ### 直接运行\r 1. 从 https://github.com/ZhengHaoF/file_server/releases/tag/beta 下载对应的压缩包\r 2. 修改config.json中需要共享的目录（不能把根目录设置为共享目录）\r 3. 双击`启动.bat` 运行",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "init": "node init.js",
        "start": "node start.js",
        "test": "node --test test/*.test.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.js\" \"**/*.mjs\" \"*.json\" \"*.md\"",
        "format:check": "prettier --check \"**/*.js\" \"**/*.mjs\" \"*.json\" \"*.md\"",
        "typecheck": "tsc --project tsconfig.json",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
        "benchmark": "node benchmark/admin.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "better-sqlite3": "^11.6.0",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "ffmpeg-static": "^5.3.0",
        "fluent-ffmpeg": "^2.1.3",
        "log4js": "^6.9.1",
        "multer": "^2.0.2",
        "sharp": "^0.35.5",
        "strip-bom": "^5.0.0",
        "ws": "^8.16.0"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^4.17.25",
        "@types/node": "^22.20.5",
        "eslint": "^10.12.0",
        "globals": "^16.5.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3"
    }
}
